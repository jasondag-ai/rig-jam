{
  "name": "rush-hour-rigs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check-levels": "node tools/check-levels.ts",
    "gen-levels": "node tools/gen-levels.ts",
    "test:e2e": "node e2e/taps.e2e.mjs",
    "test:e2e:gags": "node e2e/magpie.e2e.mjs && node e2e/eggs.e2e.mjs && node e2e/strip.e2e.mjs && node e2e/eggs2.e2e.mjs",
    "test:e2e:audio": "node e2e/audio.e2e.mjs",
    "test:e2e:log": "node e2e/log.e2e.mjs",
    "test:e2e:cover": "node e2e/cover.e2e.mjs",
    "test:e2e:sprites": "node e2e/sprites.e2e.mjs",
    "test:e2e:fit": "node e2e/fit.e2e.mjs",
    "test:e2e:menus": "node e2e/menus.e2e.mjs",
    "test:e2e:card": "node e2e/card.e2e.mjs",
    "test:e2e:hints": "node e2e/hint-shots.mjs",
    "test:e2e:magpie": "node e2e/magpie.e2e.mjs",
    "test:e2e:eggs": "node e2e/eggs.e2e.mjs",
    "test:e2e:strip": "node e2e/strip.e2e.mjs",
    "test:e2e:eggs2": "node e2e/eggs2.e2e.mjs",
    "test:e2e:night": "node e2e/night.e2e.mjs",
    "test:e2e:frames": "node e2e/frames.e2e.mjs",
    "test:e2e:lines": "node e2e/lines.e2e.mjs",
    "test:e2e:bubbles": "node e2e/bubbles.e2e.mjs",
    "test:e2e:tutorial": "node e2e/tutorial.e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "gsap": "^3.15.0"
  }
}
